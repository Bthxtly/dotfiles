#| ---------------------------Configure------------------------------------- |#
(defcfg
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad output")
  ;; cmp-seq ralt    ;; Set the compose key to `RightAlt'
  ;; cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd false

  ;; Set the implicit around to `around`
  ;; implicit-around around
)

#| -----------------------------Source-------------------------------------- |#
(defsrc ;; qwerty layout
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl      lmet lalt           spc            ralt rctl
)

#| -----------------------------Layer--------------------------------------- |#
;; layer colemak layout
(deflayer colemak
  esc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    g    j    l    u    y    ;    bspc esc  \
  lctl a    r    s    t    d    h    n    e    i    o    '    ret
  lsft z    x    c    v    b    k    m    ,    .    /    rsft
  @qwe     lalt lmet            spc            @sym rctl
)

(deflayer qwerty
  caps
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  lctl a    s    d    f    g    h    j    k    l    ;    '    ret
  @qp2  z    x    c    v    b    n    m    ,    .    /    rsft
  @col      lalt lmet           spc            @sym rctl
)

(deflayer qwerty_p2
  caps
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  kp+  up   kp-  r    t    kp3  kp4  kp5  kp6  kp*    [    ]    \
  lctl left down right f   g    kp7  kp1  kp2  kp8  ;    '    ret
  lsft kp9  x    c    v    b    n    m    ,    .    /    rsft
  @col      lalt lmet           kp0            @sym rctl
)

(deflayer symbols
  esc
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @    #    %    &    *    ^    ^    del  $    spc  bspc esc  @fuc
  @fuc grv  ~    {    [   \(    left down up   rght ret  @fuc ret
  _    !   \_    }    ]   \)    +    -    =    \    |    @fuc
  @qwe      _    _              @num           _    _
)

(deflayer numbers
  esc
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  _    _    _
  _    1    2    3    4    5    6    7    8    9    0    _    _
  .    f11  f12  \(   spc  \)   +    -    =    *    /    _
  _         _    _              _              _    _
)

(deflayer function
  esc
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @cms @ams @ms  @sms @ass @v0   @v-   @v+   pgup _    _    _    _
  _    @as  @acs @cs  @scs @ss  @mps  @mpl  @mns  pgdn _    _    _
  _    @hm  @scut @scpy @spst @ed @lch @b-  @b+   ins  _    _
  _         _    _              _              _    _
)

(deflayer blank
  _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _         _    _              _              _    _
)

#| ----------------------------Aliases-------------------------------------- |#
(defalias ;; layer
  col (layer-switch colemak)
  qwe (layer-switch qwerty)
  qp2 (layer-toggle qwerty_p2)
  num (layer-toggle numbers)
  sym (layer-toggle symbols)
  fuc (layer-toggle function)
)

(defalias ;; sticky
  ss (sticky-key 1500 rsft)
  cs (sticky-key 1500 rctl)
  as (sticky-key 1500 ralt)
  ms (sticky-key 1500 rmet)
  scs (around @cs @ss)
  acs (around @cs @as)
  cms (around @cs @ms)
  ams (around @as @ms)
  sms (around @ss @ms)
  ass (around @ss @as)
)

(defalias ;; other
  scut (around (around rctl rsft) x)
  scpy (around (around rctl rsft) c)
  spst (around (around rctl rsft) v)
  v+ VolumeUp
  v- VolumeDown 
  v0 Mute
  mpl play
  mps previoussong
  mns nextsong
  mrw rewind
  mpp pause
  mst stop
  b+ BrightnessUp
  b- BrightnessDown
  hm home
  ed end
  lch Dashboard ;; XF86Launch2
)

;; vim:fdl=0
