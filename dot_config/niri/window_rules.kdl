// https://yalter.github.io/niri/Configuration:-Window-Rules

// enable rounded corners for all windows.
window-rule {
  geometry-corner-radius 10
  clip-to-geometry true
}

// set transparency
window-rule {
  match app-id="kitty" is-focused=true
  match app-id="neovide" is-focused=true
  match app-id="com.mitchellh.ghostty" is-focused=true
  match app-id="zathura" is-focused=true

  opacity 0.85
  background-effect {
    blur true
  }
}

window-rule {
  match app-id="kitty" is-focused=false
  match app-id="neovide" is-focused=false
  match app-id="com.mitchellh.ghostty" is-focused=false
  match app-id="zathura" is-focused=false

  opacity 0.70
  background-effect {
    blur true
  }
}

// blur zen
window-rule {
  match app-id="zen-browser"

  background-effect{
    blur true
  }
}

// maximize falsh browser
window-rule {
  match app-id="Flash Browser"
  default-column-width { proportion 0.7; }
}

// maximize Minecraft
window-rule {
  match title=r#"^Minecraft\* 1\.21\.11$"#
  open-fullscreen true
  open-maximized true
}

// maximize Steam
window-rule {
  match app-id="steam" //title="Steam Big Picture Mode"
  open-maximized true
}

// open Zen at `browser` workspace
window-rule {
    match at-startup=true app-id="zen-browser"
    open-on-workspace "browser"
}

// open Spotify at `music` workspace
window-rule {
    match app-id="Spotify"
    match app-id="spotify"
    open-on-workspace "music"
    open-maximized true
}

// make goldendict float
window-rule {
  match app-id=r#"^io.github.xiaoyifang.goldendict_ng$"#
  open-floating true

  default-window-height { proportion 0.6; }
  default-column-width { proportion 0.5; }
}

// make kitty widget window float
window-rule {
  match app-id="kitty-widget"
  open-floating true

  default-window-height { proportion 0.6; }
  default-column-width { proportion 0.5; }
}

// float and size the PIP window
// https://gist.github.com/bkuri/8e017748546c8a812fb8161ade87d440
window-rule {
    match app-id="zen-browser" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-left"
}
