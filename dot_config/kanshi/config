output DP-1 {
  mode 2560x1440@180.000Hz
  scale 1.25
  position 0,0
  alias $EXT
}

output eDP-1 {
  mode 2560x1440@240.000Hz
  scale 1.6
  adaptive_sync on
  position 1920,0
  alias $INT
}

output HDMI-A-1 {
  mode 1920x1080@60.000Hz
  position 0,0
  alias $VIR
}

profile dorm {
  output $INT disable
  output $EXT enable
  output $VIR disable
}

profile dorm {
  output $INT disable
  output $EXT enable
}

profile home {
  output $INT enable
  output $VIR disable
}

profile home {
  output $INT enable
}
